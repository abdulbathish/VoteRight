{
  "name": "subsafe",
  "version": "1.0.0",
  "description": "MOSIP WebSub event listener with message decryption capabilities",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "cd $(pwd) && node src/tests/subscription-test.js",
    "test:package": "cd $(pwd) && node src/tests/package-test.js",
    "test:subscription": "cd $(pwd) && node src/tests/subscription-test.js",
    "test:debug": "LOG_LEVEL=debug cd $(pwd) && node src/tests/subscription-test.js",
    "test:init": "cd $(pwd) && node src/tests/subscription-test.js --only-init",
    "test:debug:init": "LOG_LEVEL=debug cd $(pwd) && node src/tests/subscription-test.js --only-init",
    "example:basic": "node examples/basic-usage.js",
    "example:datashare": "node examples/datashare-mode.js",
    "example:direct": "node examples/direct-mode.js",
    "validate:examples": "node scripts/validate-syntax.js",
    "publish:npm": "bash scripts/publish.sh",
    "prepare": "npm run test:package",
    "prepublishOnly": "npm run test:package"
  },
  "keywords": [
    "mosip",
    "websub",
    "decryption",
    "subscription",
    "event-listener"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ngrok": "^5.0.0-beta.2",
    "node-forge": "^1.3.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulbathish/subsafe.git"
  },
  "bugs": {
    "url": "https://github.com/abdulbathish/subsafe/issues"
  },
  "homepage": "https://github.com/abdulbathish/subsafe#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "src/**/*",
    "!src/tests/**",
    "examples/**",
    ".env.example"
  ]
}
