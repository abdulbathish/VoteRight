# Server Configuration
PORT=3000
CALLBACK_PATH=/callback/notifyEvent
CALLBACK_URL=https://your-callback-url/callback/notifyEvent

# Logging Configuration
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=silly

# Data Source Configuration
# Options: 'direct' or 'datashare'
DATA_SOURCE_MODE=datashare
# Path to find the encrypted data in direct messages (dot notation)
DIRECT_MESSAGE_PATH=event.data.credential

# MOSIP Authentication Configuration
MOSIP_BASE_URL=https://api-internal.sandbox.mosip.net
MOSIP_CLIENT_ID=mpartner-default-print
MOSIP_SECRET_KEY=your-secret-key
MOSIP_TOKEN_URL=https://iam.sandbox.mosip.net/auth/realms/mosip/protocol/openid-connect/token
MOSIP_AUTH_ENDPOINT=/v1/authmanager/authenticate/clientidsecretkey
MOSIP_APP_ID=partner

# WebSub Configuration
MOSIP_WEBSUB_URL=https://api-internal.sandbox.mosip.net/hub
MOSIP_TOPIC=mpartner-default-print/CREDENTIAL_ISSUED
MOSIP_WEBSUB_SECRET=your-secret-key

# Data Share Configuration
DATASHARE_BASE_URL=https://api-internal.sandbox.mosip.net

# Decryption Configuration
P12_PATH=./src/tests/partner.p12
P12_PASSWORD=your-password
TEMP_ENCRYPTED_FILE=./src/tests/temp-encrypted.txt
TEMP_DECRYPTED_FILE=./src/tests/temp-decrypted.txt

# Auto Subscription
AUTO_SUBSCRIBE=true 