<!-- Hero Section -->
<div class="relative isolate overflow-hidden bg-gradient-to-b from-primary-100 to-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
            <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">Democracia Voter ID System</h1>
            <p class="mt-6 text-lg leading-8 text-gray-600">The official platform for applying and managing voter identification in Democracia. Every citizen is entitled to participate in our democratic elections.</p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
                <a href="/apply" class="btn btn-primary px-5 py-2.5 text-base">
                    <i class="fas fa-id-card mr-2"></i>Apply for Voter ID
                </a>
                <a href="/status" class="btn btn-secondary px-5 py-2.5 text-base">
                    <i class="fas fa-search mr-2"></i>Check Application Status
                </a>
            </div>
        </div>
    </div>
    <div class="absolute -top-16 -left-16 opacity-10 pointer-events-none">
        <i class="fas fa-fingerprint text-primary-600" style="font-size: 40rem;"></i>
    </div>
</div>

<!-- Features Section -->
<div class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Our Services</h2>
            <p class="mt-2 text-lg leading-8 text-gray-600">Everything you need to get your voter identification.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Apply Online Card -->
            <div class="card transition-all duration-300 hover:shadow-card-hover">
                <div class="card-body flex flex-col items-center text-center">
                    <div class="h-16 w-16 rounded-full bg-primary-100 flex items-center justify-center mb-4">
                        <i class="fas fa-user-edit text-2xl text-primary-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Apply Online</h3>
                    <p class="text-gray-600 mb-5">Complete your voter ID application entirely online with our streamlined process.</p>
                    <a href="/apply" class="btn btn-primary mt-auto">Start Application</a>
                </div>
            </div>

            <!-- Track Status Card -->
            <div class="card transition-all duration-300 hover:shadow-card-hover">
                <div class="card-body flex flex-col items-center text-center">
                    <div class="h-16 w-16 rounded-full bg-primary-100 flex items-center justify-center mb-4">
                        <i class="fas fa-search text-2xl text-primary-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Track Status</h3>
                    <p class="text-gray-600 mb-5">Check the status of your voter ID application anytime, anywhere.</p>
                    <a href="/status" class="btn btn-primary mt-auto">Check Status</a>
                </div>
            </div>

            <!-- Digital Card -->
            <div class="card transition-all duration-300 hover:shadow-card-hover">
                <div class="card-body flex flex-col items-center text-center">
                    <div class="h-16 w-16 rounded-full bg-primary-100 flex items-center justify-center mb-4">
                        <i class="fas fa-id-card text-2xl text-primary-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Digital Voter Card</h3>
                    <p class="text-gray-600 mb-5">Access your digital voter card once your application is approved.</p>
                    <a href="/status" class="btn btn-primary mt-auto">View My Card</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- About Section -->
<div class="bg-gray-50 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">About The Democracia Voter ID System</h2>
            <p class="mt-6 text-lg leading-8 text-gray-600">The Democracia Voter ID System is the official platform for registering citizens to vote in our nation's elections.</p>
        </div>
        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
            <div class="relative bg-white p-6 rounded-xl shadow-sm">
                <div>
                    <p class="text-gray-700">Our secure and efficient system ensures that:</p>
                    <ul class="mt-4 space-y-2 text-gray-700">
                        <li class="flex items-center gap-x-3">
                            <i class="fas fa-check-circle text-success-500"></i>
                            <span>Every eligible citizen gets a unique voter identification</span>
                        </li>
                        <li class="flex items-center gap-x-3">
                            <i class="fas fa-check-circle text-success-500"></i>
                            <span>The electoral process remains transparent and secure</span>
                        </li>
                        <li class="flex items-center gap-x-3">
                            <i class="fas fa-check-circle text-success-500"></i>
                            <span>Citizens can easily apply for and manage their voter credentials</span>
                        </li>
                        <li class="flex items-center gap-x-3">
                            <i class="fas fa-check-circle text-success-500"></i>
                            <span>The integrity of our democratic process is maintained</span>
                        </li>
                    </ul>
                    <p class="mt-6 text-gray-700">
                        As mandated by the Electoral Act of Democracia, 
                        <% if (parseInt(process.env.MIN_VOTER_AGE) > 0) { %>
                            all citizens aged <%= process.env.MIN_VOTER_AGE %> and above are required to register
                        <% } else { %>
                            all citizens are eligible to register
                        <% } %>
                        in the national voter database to participate in elections.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-gradient-to-r from-primary-600 to-primary-700">
                    <h3 class="text-xl font-semibold text-white">Why You Need a Voter ID</h3>
                </div>
                <div class="card-body">
                    <div class="space-y-6">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <div class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-50 text-primary-700">
                                    <i class="fas fa-vote-yea text-xl"></i>
                                </div>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-lg font-medium text-gray-900">Participate in Elections</h4>
                                <p class="mt-2 text-gray-600">A voter ID is required to cast your ballot in local and national elections.</p>
                            </div>
                        </div>

                        <div class="flex">
                            <div class="flex-shrink-0">
                                <div class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-50 text-primary-700">
                                    <i class="fas fa-shield-alt text-xl"></i>
                                </div>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-lg font-medium text-gray-900">Prevent Fraud</h4>
                                <p class="mt-2 text-gray-600">Secure identification helps prevent electoral fraud and maintains integrity.</p>
                            </div>
                        </div>

                        <div class="flex">
                            <div class="flex-shrink-0">
                                <div class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-50 text-primary-700">
                                    <i class="fas fa-id-badge text-xl"></i>
                                </div>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-lg font-medium text-gray-900">Official ID</h4>
                                <p class="mt-2 text-gray-600">Your voter card can also serve as an official government identification.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 