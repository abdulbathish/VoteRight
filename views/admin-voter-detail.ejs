<!-- Admin Voter Detail Page -->
<div class="bg-gray-50 min-h-screen pb-8">
    <div class="container mx-auto px-4 pt-6">
        <!-- Application Header Banner -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-4">
            <div class="px-6 py-3 flex items-center justify-between">
                <div class="flex items-center">
                    <div class="flex-shrink-0 h-9 w-9 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                        <% if(voter.photoPath) { %>
                            <img src="/<%= voter.photoPath %>" alt="<%= voter.firstName %>" class="h-full w-full object-cover rounded-full">
                        <% } else { %>
                            <i class="fas fa-user text-blue-600"></i>
                        <% } %>
                    </div>
                    <div>
                        <div class="flex items-center">
                            <h2 class="text-lg font-semibold text-gray-800"><%= voter.firstName %> <%= voter.lastName %></h2>
                            <% if(voter.status === 'approved') { %>
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 ml-2">
                                    <i class="fas fa-check-circle mr-1"></i> Approved<% if(voter.approvedAt) { %> on <%= voter.approvedAt.toLocaleDateString() %><% } %>
                                </span>
                            <% } %>
                        </div>
                        <p class="text-xs text-gray-500">Voter ID: <%= voter.id %></p>
                    </div>
                </div>
                
                <a href="/admin/dashboard" class="inline-flex items-center px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition-colors">
                    <i class="fas fa-arrow-left text-sm mr-1.5"></i>
                    Back
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Left Column (Photo & Actions) -->
            <div class="space-y-4">
                <!-- Photo Container -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-gray-50">
                        <h6 class="font-medium text-gray-700">Applicant Photo</h6>
                    </div>
                    <div class="p-4 flex items-center justify-center bg-gray-50">
                        <% if(voter.photoPath) { %>
                            <img src="/<%= voter.photoPath %>" alt="Applicant Photo" class="max-w-full rounded-md shadow-sm">
                        <% } else { %>
                            <div class="bg-blue-50 text-blue-700 p-4 rounded-md w-full flex items-center justify-center">
                                <i class="fas fa-image mr-2"></i> No photo uploaded
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Application Timeline -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-gray-50">
                        <h6 class="font-medium text-gray-700">Application Timeline</h6>
                    </div>
                    <div class="p-4">
                        <div class="space-y-3">
                            <div class="flex items-center">
                                <div class="w-9 h-9 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-file-alt text-blue-600"></i>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-medium text-gray-900">Application Submitted</h3>
                                    <p class="text-xs text-gray-500"><%= voter.createdAt.toLocaleDateString() %></p>
                                </div>
                            </div>
                            
                            <% if(voter.status === 'approved' && voter.approvedAt) { %>
                                <div class="flex items-center">
                                    <div class="w-9 h-9 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-check text-green-600"></i>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-gray-900">Application Approved</h3>
                                        <p class="text-xs text-gray-500"><%= voter.approvedAt.toLocaleDateString() %></p>
                                    </div>
                                </div>
                            <% } else if(voter.status === 'rejected' && voter.rejectedAt) { %>
                                <div class="flex items-center">
                                    <div class="w-9 h-9 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-times text-red-600"></i>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-gray-900">Application Rejected</h3>
                                        <p class="text-xs text-gray-500"><%= voter.rejectedAt.toLocaleDateString() %></p>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="flex items-center">
                                    <div class="w-9 h-9 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-clock text-yellow-600"></i>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-gray-900">Awaiting Decision</h3>
                                        <p class="text-xs text-gray-500">Under review</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <% if(voter.status === 'pending') { %>
                    <div class="flex space-x-2">
                        <form action="/admin/approve/<%= voter.id %>?returnTo=/admin/voter/<%= voter.id %>" method="POST" class="flex-1">
                            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-3 rounded-md text-sm transition-colors">
                                <i class="fas fa-check mr-1"></i> Approve
                            </button>
                        </form>
                        <form action="/admin/reject/<%= voter.id %>?returnTo=/admin/voter/<%= voter.id %>" method="POST" class="flex-1">
                            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 px-3 rounded-md text-sm transition-colors">
                                <i class="fas fa-times mr-1"></i> Reject
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
            
            <!-- Right Column (Personal Details & Additional Info) -->
            <div class="md:col-span-2 space-y-4">
                <!-- Personal Information -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-gray-50">
                        <h6 class="font-medium text-gray-700">Personal Information</h6>
                    </div>
                    <div class="divide-y divide-gray-200">
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">First Name</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.firstName %></div>
                        </div>
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">Last Name</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.lastName %></div>
                        </div>
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">Date of Birth</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.dob %></div>
                        </div>
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">Address</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.address %></div>
                        </div>
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">National ID</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.idNumber %></div>
                        </div>
                        <div class="grid grid-cols-3 py-2 px-4">
                            <div class="text-sm font-medium text-gray-500">Registration ID</div>
                            <div class="col-span-2 text-sm text-gray-900"><%= voter.registrationId || voter.idNumber %></div>
                        </div>
                    </div>
                </div>
                
                <!-- Contact Information -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-gray-50">
                        <h6 class="font-medium text-gray-700">Contact Information</h6>
                    </div>
                    <div class="divide-y divide-gray-200">
                        <% if(voter.email) { %>
                            <div class="grid grid-cols-3 py-2 px-4">
                                <div class="text-sm font-medium text-gray-500">Email</div>
                                <div class="col-span-2 text-sm text-gray-900">
                                    <a href="mailto:<%= voter.email %>" class="text-blue-600 hover:underline">
                                        <%= voter.email %>
                                    </a>
                                </div>
                            </div>
                        <% } %>
                        <% if(voter.phone) { %>
                            <div class="grid grid-cols-3 py-2 px-4">
                                <div class="text-sm font-medium text-gray-500">Phone</div>
                                <div class="col-span-2 text-sm text-gray-900">
                                    <a href="tel:<%= voter.phone %>" class="text-blue-600 hover:underline">
                                        <%= voter.phone %>
                                    </a>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome for icons -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js" integrity="sha512-Tn2m0TIpgVyTzzvmxLNuqbSJH3JP8jm+Cy3hvHrW7ndTDcJ1w5mBiksqDBb8GpE2ksktFvDB/ykZ0mDpsZj20w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> 