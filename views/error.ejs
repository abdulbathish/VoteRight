<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger mb-4">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Error</h3>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fas fa-exclamation-circle text-danger fa-5x mb-3"></i>
                    <h4 class="text-danger">An error has occurred</h4>
                    <p class="lead"><%= message %></p>
                </div>
                
                <div class="alert alert-info">
                    <h5><i class="fas fa-info-circle me-2"></i>What to do next?</h5>
                    <p>You can try one of the following options:</p>
                    <ul>
                        <li>Return to the home page</li>
                        <li>Contact our support team for assistance</li>
                        <li>Check your application status if you've already applied</li>
                    </ul>
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="/" class="btn btn-outline-primary">
                        <i class="fas fa-home me-2"></i>Home
                    </a>
                    <a href="/status" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>Check Status
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 