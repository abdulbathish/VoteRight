<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="fas fa-search-plus me-2"></i>Application Status</h3>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <% if(voter.status === 'approved') { %>
                        <div class="mb-3">
                            <i class="fas fa-check-circle text-success fa-5x"></i>
                        </div>
                        <h4 class="text-success">Congratulations! Your application has been approved.</h4>
                    <% } else if(voter.status === 'rejected') { %>
                        <div class="mb-3">
                            <i class="fas fa-times-circle text-danger fa-5x"></i>
                        </div>
                        <h4 class="text-danger">Unfortunately, your application has been rejected.</h4>
                    <% } else { %>
                        <div class="mb-3">
                            <i class="fas fa-clock text-warning fa-5x"></i>
                        </div>
                        <h4 class="text-warning">Your application is currently under review.</h4>
                    <% } %>
                </div>
                
                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Application Details</h5>
                        <table class="table table-bordered">
                            <tr>
                                <th style="width: 40%">Voter ID:</th>
                                <td class="fw-bold"><span class="text-primary"><%= voter.id %></span></td>
                            </tr>
                            <tr>
                                <th>RID (Registration ID):</th>
                                <td class="fw-bold"><%= voter.registrationId %></td>
                            </tr>
                            <tr>
                                <th>Name:</th>
                                <td><%= voter.firstName %> <%= voter.lastName %></td>
                            </tr>
                            <tr>
                                <th>Date of Birth:</th>
                                <td><%= voter.dob %></td>
                            </tr>
                            <tr>
                                <th>Application Date:</th>
                                <td><%= voter.createdAt.toLocaleDateString() %></td>
                            </tr>
                            <tr>
                                <th>Status:</th>
                                <td>
                                    <% if(voter.status === 'approved') { %>
                                        <span class="badge bg-success">Approved</span>
                                    <% } else if(voter.status === 'rejected') { %>
                                        <span class="badge bg-danger">Rejected</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending Review</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% if(voter.status === 'approved' && voter.approvedAt) { %>
                            <tr>
                                <th>Approval Date:</th>
                                <td><%= voter.approvedAt.toLocaleDateString() %></td>
                            </tr>
                            <% } %>
                            <% if(voter.status === 'rejected' && voter.rejectedAt) { %>
                            <tr>
                                <th>Rejection Date:</th>
                                <td><%= voter.rejectedAt.toLocaleDateString() %></td>
                            </tr>
                            <% } %>
                        </table>
                    </div>
                </div>
                
                <% if(voter.status === 'approved') { %>
                <div class="alert alert-success">
                    <h5><i class="fas fa-id-card me-2"></i>Your Voter ID Card is Ready!</h5>
                    <p>You can now download your digital voter ID card or visit our office to collect the physical card.</p>
                    <div class="mt-3">
                        <a href="/voter-card/<%= voter.id %>" class="btn btn-success" target="_blank">
                            <i class="fas fa-download me-2"></i>Download Digital Voter ID
                        </a>
                    </div>
                </div>
                <% } else if(voter.status === 'rejected') { %>
                <div class="alert alert-danger">
                    <h5><i class="fas fa-exclamation-triangle me-2"></i>Application Rejected</h5>
                    <p>Your application has been rejected. Please visit our office with your national ID for more information.</p>
                </div>
                <% } else { %>
                <div class="alert alert-warning">
                    <h5><i class="fas fa-hourglass-half me-2"></i>Application in Process</h5>
                    <p>Your application is currently being reviewed. This process typically takes 3-5 business days.</p>
                </div>
                <% } %>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="/status" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Status Check
                    </a>
                    <a href="/" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 