<div class="container max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <div class="mb-8 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="fas fa-id-card text-primary-600 mr-3 text-3xl"></i>
            Your Voter ID Card
        </h1>
        <div class="flex space-x-3">
            <button id="printCard" class="btn btn-outline flex items-center">
                <i class="fas fa-print mr-2"></i>Print Card
            </button>
            <button class="btn btn-outline copy-id flex items-center" data-id="<%= voter.id %>">
                <i class="fas fa-copy mr-2"></i>Copy ID
            </button>
        </div>
    </div>
    
    <!-- Voter ID Card -->
    <div class="voter-id-card mb-8 relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-20 pointer-events-none">
            <div class="absolute top-0 right-0 w-full h-full overflow-hidden">
                <img src="https://upload.wikimedia.org/wikipedia/commons/1/17/Guilloch%C3%A9_pattern_for_a_banknote.png" 
                    alt="Security Pattern" class="object-cover w-full h-full opacity-30">
            </div>
        </div>
        
        <div class="voter-id-card-content relative z-10">
            <div class="grid grid-cols-12 gap-6">
                <!-- Left Column (Card Information) -->
                <div class="col-span-12 md:col-span-9">
                    <!-- Header with logo -->
                    <div class="voter-id-card-header">
                        <img src="/images/democracia-logo.png" alt="Democracia Electoral Commission Logo" 
                            class="h-12 w-12" onerror="this.src='https://placehold.co/60x60/fff/0369a1?text=EC&font=bold'">
                        <div>
                            <h2 class="voter-id-card-title">DEMOCRACIA</h2>
                            <p class="voter-id-card-subtitle">Electoral Commission</p>
                        </div>
                    </div>
                    
                    <h3 class="uppercase tracking-wider font-semibold my-4">Official Voter Identification Card</h3>
                    
                    <!-- Main card details in 2-column grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="voter-id-card-field-label">Full Name</p>
                            <p class="voter-id-card-field-value"><%= voter.firstName %> <%= voter.lastName %></p>
                        </div>
                        <div>
                            <p class="voter-id-card-field-label">Voter ID</p>
                            <p class="voter-id-card-id"><%= voter.id %></p>
                        </div>
                        <div>
                            <p class="voter-id-card-field-label">Date of Birth</p>
                            <p class="voter-id-card-field-value"><%= new Date(voter.dob).toLocaleDateString() %></p>
                        </div>
                        <div>
                            <p class="voter-id-card-field-label">National ID</p>
                            <p class="voter-id-card-field-value"><%= voter.idNumber %></p>
                        </div>
                        <div>
                            <p class="voter-id-card-field-label">Issue Date</p>
                            <p class="voter-id-card-field-value"><%= voter.approvedAt.toLocaleDateString() %></p>
                        </div>
                        <div>
                            <p class="voter-id-card-field-label">Expiry Date</p>
                            <p class="voter-id-card-field-value"><%= expiryDate.toLocaleDateString() %></p>
                        </div>
                    </div>
                    
                    <!-- Address section -->
                    <div class="mt-4">
                        <p class="voter-id-card-field-label">Address</p>
                        <p class="voter-id-card-field-value"><%= voter.address %></p>
                    </div>
                </div>
                
                <!-- Right Column (Photo and QR) -->
                <div class="col-span-12 md:col-span-3 flex flex-col items-center justify-between">
                    <div class="voter-id-card-photo w-full">
                        <% if(voter.photoPath) { %>
                            <img src="/<%= voter.photoPath %>" alt="Voter Photo" class="w-full rounded object-cover aspect-[3/4]">
                        <% } else { %>
                            <img src="https://placehold.co/150x200/fff/ccc?text=PHOTO" alt="Placeholder" class="w-full rounded">
                        <% } %>
                    </div>
                    
                    <div class="voter-id-card-qr mt-4">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=<%= voter.id %>" 
                            alt="QR Code" class="w-24 h-24">
                    </div>
                </div>
            </div>
            
            <!-- Card footer -->
            <div class="voter-id-card-footer flex justify-between items-end">
                <div class="max-w-lg">
                    <p>This card is the property of the Democracia Electoral Commission. If found, please return to the nearest electoral office.</p>
                </div>
                <div class="flex-shrink-0">
                    <img src="/images/signature.png" alt="Official Signature" class="h-10" 
                        onerror="this.src='https://placehold.co/120x40/fff/ccc?text=Signature'">
                </div>
            </div>
        </div>
    </div>
    
    <!-- Important Information Card -->
    <div class="card">
        <div class="card-header">
            <h3 class="text-lg font-medium text-gray-900">Important Information</h3>
        </div>
        <div class="card-body">
            <ul class="space-y-2 text-gray-700 mb-6">
                <li class="flex items-start">
                    <i class="fas fa-circle text-xs mt-1.5 mr-2 text-primary-600"></i>
                    <span>This voter ID card is official and valid for use in all elections in Democracia.</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-circle text-xs mt-1.5 mr-2 text-primary-600"></i>
                    <span>You must present this card at your polling station to vote.</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-circle text-xs mt-1.5 mr-2 text-primary-600"></i>
                    <span>The card is valid until the expiry date shown.</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-circle text-xs mt-1.5 mr-2 text-primary-600"></i>
                    <span>Report lost or stolen cards immediately to the Electoral Commission.</span>
                </li>
                <li class="flex items-start">
                    <i class="fas fa-circle text-xs mt-1.5 mr-2 text-primary-600"></i>
                    <span>Tampering with or misuse of this card is a criminal offense.</span>
                </li>
            </ul>
            
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-info-circle text-success-600 text-xl"></i>
                    </div>
                    <div class="ml-3">
                        <h4 class="text-success-800 font-medium">Digital Card Security</h4>
                        <p class="text-success-700 text-sm mt-1">
                            Your digital voter ID card is protected with secure hash technology. Officials can verify its authenticity using the QR code or ID number.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Print functionality
    document.getElementById('printCard').addEventListener('click', function() {
        window.print();
    });
    
    // Copy ID functionality
    document.querySelectorAll('.copy-id').forEach(button => {
        button.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            navigator.clipboard.writeText(id).then(() => {
                // Show temporary success message
                const originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-check mr-2"></i>Copied!';
                this.classList.add('bg-success-50', 'text-success-700', 'border-success-200');
                
                setTimeout(() => {
                    this.innerHTML = originalText;
                    this.classList.remove('bg-success-50', 'text-success-700', 'border-success-200');
                }, 2000);
            });
        });
    });
</script> 