<div class="max-w-3xl mx-auto animate__animated animate__fadeIn">
    <!-- Status Check Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-8">
        <div class="bg-gradient-to-r from-primary-700 to-primary-800 px-6 py-6 text-white">
            <h1 class="text-2xl font-bold flex items-center">
                <div class="bg-white/20 p-2 rounded-lg mr-3">
                    <i class="fas fa-search text-white text-xl"></i>
                </div>
                Check Application Status
            </h1>
            <p class="mt-2 text-primary-100">Track your voter ID application and view its current processing stage</p>
        </div>
        
        <div class="p-8">
            <% if (typeof error !== 'undefined') { %>
                <div class="mb-6 rounded-md bg-danger-50 p-4 border-l-4 border-danger-500 shadow-sm animate__animated animate__headShake">
                    <div class="flex">
                        <i class="fas fa-exclamation-circle text-danger-500 mt-0.5 flex-shrink-0 text-lg"></i>
                        <div class="ml-3">
                            <h3 class="text-danger-800 font-medium">Error</h3>
                            <p class="text-danger-700 mt-1"><%= error %></p>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <form action="/status" method="POST" class="space-y-6">
                <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.1s">
                    <label for="rid" class="form-label text-gray-800 font-medium">Registration ID (RID)</label>
                    <div class="search-box mt-1">
                        <div class="search-icon">
                            <i class="fas fa-id-card text-gray-400"></i>
                        </div>
                        <input type="text" id="rid" name="rid" 
                            class="search-input" 
                            placeholder="Enter your Registration ID (RID)" 
                            required 
                            value="<%= locals.rid || '' %>">
                    </div>
                    <p class="mt-2 text-sm text-gray-500">Enter the Registration ID (RID) you received when applying</p>
                </div>
                
                <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.2s">
                    <label for="email" class="form-label text-gray-800 font-medium">Email Address or Phone Number</label>
                    <div class="search-box mt-1">
                        <div class="search-icon">
                            <i class="fas fa-envelope text-gray-400"></i>
                        </div>
                        <input type="text" id="email" name="email" 
                            class="search-input" 
                            placeholder="Enter your email address or phone number" 
                            required 
                            value="<%= locals.email || '' %>">
                    </div>
                    <p class="mt-2 text-sm text-gray-500">Enter the email address or phone number you provided during registration</p>
                </div>
                
                <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.3s">
                    <button type="submit" class="w-full btn btn-primary py-3 shadow-md text-base font-medium transition-transform duration-200 hover:transform hover:scale-[1.02]">
                        <i class="fas fa-search mr-2"></i>Check Status
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Help Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden animate__animated animate__fadeInUp" style="animation-delay: 0.4s">
        <div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                <i class="fas fa-question-circle text-primary-600 mr-2"></i>
                Lost Your Registration Details?
            </h3>
        </div>
        
        <div class="p-8">
            <p class="text-gray-700 mb-6">If you don't have your registration information, you can:</p>
            
            <ul class="space-y-4 text-gray-700 mb-6">
                <li class="flex items-start bg-gray-50 p-4 rounded-lg hover:bg-gray-100 transition-colors duration-200">
                    <div class="bg-primary-100 text-primary-700 p-2 rounded-full mr-3">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <span class="font-medium text-gray-900">Check your email</span>
                        <p class="mt-1 text-gray-600">Look for a confirmation message sent to the email you provided during registration</p>
                    </div>
                </li>
                <li class="flex items-start bg-gray-50 p-4 rounded-lg hover:bg-gray-100 transition-colors duration-200">
                    <div class="bg-primary-100 text-primary-700 p-2 rounded-full mr-3">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <span class="font-medium text-gray-900">Visit our office</span>
                        <p class="mt-1 text-gray-600">Come to our office in person with your national ID card for verification</p>
                    </div>
                </li>
                <li class="flex items-start bg-gray-50 p-4 rounded-lg hover:bg-gray-100 transition-colors duration-200">
                    <div class="bg-primary-100 text-primary-700 p-2 rounded-full mr-3">
                        <i class="fas fa-headset"></i>
                    </div>
                    <div>
                        <span class="font-medium text-gray-900">Contact support</span>
                        <p class="mt-1 text-gray-600">Email our support team at <a href="mailto:support@democracia-ec.gov" class="text-primary-600 hover:text-primary-700 underline font-medium">support@democracia-ec.gov</a></p>
                    </div>
                </li>
            </ul>
            
            <div class="bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 rounded-lg p-4 shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0 bg-blue-100 p-2 rounded-full">
                        <i class="fas fa-info-circle text-blue-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h4 class="text-blue-800 font-medium">Need Help?</h4>
                        <p class="text-blue-700 mt-1">
                            Our customer support center is available Monday through Friday, 9am to 5pm. 
                            Call us at <span class="font-medium">+1-234-567-8901</span>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Add focus effect to input fields
    const inputs = document.querySelectorAll('.search-input');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.parentElement.classList.add('shadow-md');
        });
        input.addEventListener('blur', function() {
            this.parentElement.classList.remove('shadow-md');
        });
    });
</script> 