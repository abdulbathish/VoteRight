<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="fas fa-search me-2"></i>Check Application Status</h3>
            </div>
            <div class="card-body">
                <p class="mb-4">Enter your information to check the current status of your voter ID application.</p>
                
                <% if (typeof error !== 'undefined') { %>
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                    </div>
                <% } %>
                
                <form action="/status" method="POST">
                    <div class="mb-3">
                        <label for="rid" class="form-label">RID (Registration ID)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                            <input type="text" class="form-control" id="rid" name="rid" placeholder="Enter your Registration ID (RID)" required value="<%= locals.rid || '' %>">
                        </div>
                        <small class="text-muted">Enter your Registration ID (RID) number</small>
                    </div>
                    
                    <div class="mb-4">
                        <label for="email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email address" required value="<%= locals.email || '' %>">
                        </div>
                        <small class="text-muted">Enter the email you provided during registration</small>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>Check Status
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">Lost Your Registration Details?</h5>
            </div>
            <div class="card-body">
                <p>If you don't have your registration information, you can:</p>
                <ul>
                    <li>Check your email for a confirmation message (if you provided an email)</li>
                    <li>Visit our office in person with your national ID card</li>
                    <li>Contact our support team at <a href="mailto:support@democracia-ec.gov">support@democracia-ec.gov</a></li>
                </ul>
                
                <div class="alert alert-info">
                    <div class="d-flex">
                        <div class="me-3">
                            <i class="fas fa-info-circle fa-2x"></i>
                        </div>
                        <div>
                            <strong>Need Help?</strong>
                            <p class="mb-0">Our customer support center is available Monday through Friday, 9am to 5pm. Call us at +1-234-567-8901.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 