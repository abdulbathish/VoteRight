<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
    <a href="/admin/logout" class="btn btn-outline-danger">
        <i class="fas fa-sign-out-alt me-2"></i>Logout
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Applications</h5>
                        <h2 class="display-4"><%= voters.length %></h2>
                    </div>
                    <div>
                        <i class="fas fa-file-alt fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Approved</h5>
                        <h2 class="display-4"><%= voters.filter(voter => voter.status === 'approved').length %></h2>
                    </div>
                    <div>
                        <i class="fas fa-check-circle fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Pending</h5>
                        <h2 class="display-4"><%= voters.filter(voter => voter.status === 'pending').length %></h2>
                    </div>
                    <div>
                        <i class="fas fa-clock fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Voter ID Applications</h3>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <% if (voters.length === 0) { %>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No applications have been submitted yet.
                </div>
            <% } else { %>
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Date of Birth</th>
                            <th>Application Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% voters.forEach(voter => { %>
                            <tr>
                                <td><%= voter.id %></td>
                                <td><%= voter.firstName %> <%= voter.lastName %></td>
                                <td><%= voter.dob %></td>
                                <td><%= voter.createdAt.toLocaleDateString() %></td>
                                <td>
                                    <% if(voter.status === 'approved') { %>
                                        <span class="badge bg-success">Approved</span>
                                    <% } else if(voter.status === 'rejected') { %>
                                        <span class="badge bg-danger">Rejected</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#viewModal<%= voter.id.replace(/\W/g, '') %>">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <% if(voter.status === 'pending') { %>
                                            <form action="/admin/approve/<%= voter.id %>" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/reject/<%= voter.id %>" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            
                            <!-- View Modal for each voter -->
                            <div class="modal fade" id="viewModal<%= voter.id.replace(/\W/g, '') %>" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Application Details</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <table class="table table-bordered">
                                                        <tr>
                                                            <th>ID:</th>
                                                            <td><%= voter.id %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>First Name:</th>
                                                            <td><%= voter.firstName %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Last Name:</th>
                                                            <td><%= voter.lastName %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Date of Birth:</th>
                                                            <td><%= voter.dob %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Address:</th>
                                                            <td><%= voter.address %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>National ID:</th>
                                                            <td><%= voter.idNumber %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>RID (Registration ID):</th>
                                                            <td><%= voter.registrationId || voter.idNumber %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Application Date:</th>
                                                            <td><%= voter.createdAt.toLocaleDateString() %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Status:</th>
                                                            <td>
                                                                <% if(voter.status === 'approved') { %>
                                                                    <span class="badge bg-success">Approved</span>
                                                                <% } else if(voter.status === 'rejected') { %>
                                                                    <span class="badge bg-danger">Rejected</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card">
                                                        <div class="card-header">
                                                            <h6 class="mb-0">Applicant Photo</h6>
                                                        </div>
                                                        <div class="card-body text-center">
                                                            <% if(voter.photoPath) { %>
                                                                <img src="/<%= voter.photoPath %>" alt="Applicant Photo" class="img-fluid">
                                                            <% } else { %>
                                                                <div class="alert alert-info">No photo uploaded</div>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <% if(voter.status === 'pending') { %>
                                                <form action="/admin/approve/<%= voter.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-success">Approve</button>
                                                </form>
                                                <form action="/admin/reject/<%= voter.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-danger">Reject</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div> 