<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold flex items-center"><i class="fas fa-tachometer-alt mr-2"></i>Admin Dashboard</h2>
    <a href="/admin/logout" class="px-4 py-2 bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition flex items-center">
        <i class="fas fa-sign-out-alt mr-2"></i>Logout
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-blue-600 text-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-lg font-semibold mb-1">Total Applications</h5>
                <h2 class="text-4xl font-bold"><%= voters.length %></h2>
            </div>
            <div class="bg-blue-500 p-3 rounded-full">
                <i class="fas fa-file-alt text-3xl"></i>
            </div>
        </div>
    </div>
    
    <div class="bg-green-600 text-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-lg font-semibold mb-1">Approved</h5>
                <h2 class="text-4xl font-bold"><%= voters.filter(voter => voter.status === 'approved').length %></h2>
            </div>
            <div class="bg-green-500 p-3 rounded-full">
                <i class="fas fa-check-circle text-3xl"></i>
            </div>
        </div>
    </div>
    
    <div class="bg-yellow-500 text-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-lg font-semibold mb-1">Pending</h5>
                <h2 class="text-4xl font-bold"><%= voters.filter(voter => voter.status === 'pending').length %></h2>
            </div>
            <div class="bg-yellow-400 p-3 rounded-full">
                <i class="fas fa-clock text-3xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="bg-gray-100 px-6 py-4 border-b">
        <h3 class="text-xl font-semibold">Voter ID Applications</h3>
    </div>
    <div class="p-6">
        <% if (voters.length === 0) { %>
            <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4 mb-4">
                <div class="flex">
                    <i class="fas fa-info-circle mt-1 mr-2"></i>
                    <p>No applications have been submitted yet.</p>
                </div>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-800 text-white">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Date of Birth</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Application Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% voters.forEach(voter => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm"><%= voter.id %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm"><%= voter.firstName %> <%= voter.lastName %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm"><%= voter.dob %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm"><%= voter.createdAt.toLocaleDateString() %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <% if(voter.status === 'approved') { %>
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
                                    <% } else if(voter.status === 'rejected') { %>
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                                    <% } else { %>
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <div class="flex space-x-2">
                                        <button class="p-1.5 bg-blue-100 text-blue-600 rounded hover:bg-blue-200 transition" data-bs-toggle="modal" data-bs-target="#viewModal<%= voter.id.replace(/\W/g, '') %>">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <% if(voter.status === 'pending') { %>
                                            <form action="/admin/approve/<%= voter.id %>" method="POST" class="inline">
                                                <button type="submit" class="p-1.5 bg-green-100 text-green-600 rounded hover:bg-green-200 transition">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/reject/<%= voter.id %>" method="POST" class="inline">
                                                <button type="submit" class="p-1.5 bg-red-100 text-red-600 rounded hover:bg-red-200 transition">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            
                            <!-- View Modal for each voter -->
                            <div class="modal fade" id="viewModal<%= voter.id.replace(/\W/g, '') %>" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header border-b">
                                            <h5 class="text-lg font-semibold">Application Details</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-6">
                                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                                <div class="col-span-2">
                                                    <table class="min-w-full border">
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">ID:</th>
                                                            <td class="py-2 px-4"><%= voter.id %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">First Name:</th>
                                                            <td class="py-2 px-4"><%= voter.firstName %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">Last Name:</th>
                                                            <td class="py-2 px-4"><%= voter.lastName %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">Date of Birth:</th>
                                                            <td class="py-2 px-4"><%= voter.dob %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">Address:</th>
                                                            <td class="py-2 px-4"><%= voter.address %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">National ID:</th>
                                                            <td class="py-2 px-4"><%= voter.idNumber %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">RID:</th>
                                                            <td class="py-2 px-4"><%= voter.registrationId || voter.idNumber %></td>
                                                        </tr>
                                                        <tr class="border-b">
                                                            <th class="py-2 px-4 bg-gray-100 text-left">Application Date:</th>
                                                            <td class="py-2 px-4"><%= voter.createdAt.toLocaleDateString() %></td>
                                                        </tr>
                                                        <tr>
                                                            <th class="py-2 px-4 bg-gray-100 text-left">Status:</th>
                                                            <td class="py-2 px-4">
                                                                <% if(voter.status === 'approved') { %>
                                                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
                                                                <% } else if(voter.status === 'rejected') { %>
                                                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                                                                <% } else { %>
                                                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                                <div>
                                                    <div class="border rounded-lg overflow-hidden">
                                                        <div class="bg-gray-100 px-4 py-2 border-b">
                                                            <h6 class="font-medium">Applicant Photo</h6>
                                                        </div>
                                                        <div class="p-4 text-center">
                                                            <% if(voter.photoPath) { %>
                                                                <img src="/<%= voter.photoPath %>" alt="Applicant Photo" class="max-w-full mx-auto">
                                                            <% } else { %>
                                                                <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-3">No photo uploaded</div>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-t p-4 flex justify-end space-x-2">
                                            <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition" data-bs-dismiss="modal">Close</button>
                                            <% if(voter.status === 'pending') { %>
                                                <form action="/admin/approve/<%= voter.id %>" method="POST" class="inline">
                                                    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition">Approve</button>
                                                </form>
                                                <form action="/admin/reject/<%= voter.id %>" method="POST" class="inline">
                                                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition">Reject</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div> 