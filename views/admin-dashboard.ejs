<!-- Admin Dashboard -->
<div class="bg-gray-50 min-h-screen pb-8">
    <div class="container mx-auto px-4 pt-6">
        <h1 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
            <i class="fas fa-user-shield text-blue-600 mr-3"></i>
            Administration Portal
        </h1>
        
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <!-- Total Applications Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 transition-all duration-200 hover:shadow-md p-4">
                <div class="flex flex-col">
                    <div class="flex items-center mb-1">
                        <i class="fas fa-file-alt text-blue-600 text-lg mr-2"></i>
                        <span class="text-gray-500 text-xs uppercase font-medium">TOTAL APPLICATIONS</span>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-800 pl-7"><%= totalVoters %></h2>
                </div>
            </div>
            
            <!-- Approved Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 transition-all duration-200 hover:shadow-md p-4">
                <div class="flex flex-col">
                    <div class="flex items-center mb-1">
                        <i class="fas fa-check-circle text-green-600 text-lg mr-2"></i>
                        <span class="text-gray-500 text-xs uppercase font-medium">APPROVED</span>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-800 pl-7"><%= totalApproved %></h2>
                </div>
            </div>
            
            <!-- Pending Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 transition-all duration-200 hover:shadow-md p-4">
                <div class="flex flex-col">
                    <div class="flex items-center mb-1">
                        <i class="fas fa-clock text-amber-600 text-lg mr-2"></i>
                        <span class="text-gray-500 text-xs uppercase font-medium">PENDING</span>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-800 pl-7"><%= totalPending %></h2>
                </div>
            </div>
        </div>

        <!-- Applications List -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
            <!-- Improved Filter Controls Section -->
            <div class="border-b border-gray-100 bg-gray-50">
                <div class="flex items-center justify-between p-4 md:p-6">
                    <h3 class="text-lg font-semibold text-gray-800">Voter ID Applications</h3>
                    
                    <div class="flex flex-row items-center space-x-3">
                        <!-- Status Dropdown with Icon -->
                        <div class="relative">
                            <select id="statusFilter" class="appearance-none pl-10 pr-10 py-2 bg-white border border-gray-200 rounded-lg text-sm text-gray-700 focus:border-blue-400 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-colors duration-200 shadow-sm hover:border-gray-300">
                                <option value="all" <%= filters && filters.status === 'all' ? 'selected' : '' %>>All Status</option>
                                <option value="pending" <%= filters && filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="approved" <%= filters && filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                <option value="rejected" <%= filters && filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                            </select>
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-filter text-gray-400"></i>
                            </div>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-gray-400 text-xs"></i>
                            </div>
                        </div>
                        
                        <!-- Improved Search Box with Clear Button -->
                        <div class="relative">
                            <input type="text" id="searchBox" placeholder="Search by name or ID" 
                                   value="<%= filters && filters.search ? filters.search : '' %>"
                                   class="pl-10 pr-10 py-2 w-64 border border-gray-200 rounded-lg text-sm text-gray-700 focus:border-blue-400 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-colors duration-200 shadow-sm hover:border-gray-300" />
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                            <button id="clearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none transition-colors duration-200 <%= !filters || !filters.search ? 'hidden' : '' %>">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Active Filters Section -->
                <div id="activeFilters" class="px-6 pb-4 flex flex-wrap items-center gap-2 <%= (!filters || (filters.status === 'all' && !filters.search)) ? 'hidden' : '' %>">
                    <span class="text-sm font-medium text-gray-500">Active filters:</span>
                    <!-- Status filter badge (added dynamically) -->
                    <div id="statusBadge" class="<%= (!filters || filters.status === 'all') ? 'hidden' : '' %> px-3 py-1.5 bg-blue-50 text-blue-600 text-xs font-medium rounded-full flex items-center">
                        <i class="fas fa-filter text-blue-600 mr-2"></i>
                        <span id="statusBadgeText">Status: <%= filters && filters.status !== 'all' ? filters.status.charAt(0).toUpperCase() + filters.status.slice(1) : 'All' %></span>
                        <button class="ml-2 focus:outline-none hover:text-blue-800" id="clearStatusFilter">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                    
                    <!-- Search filter badge (added dynamically) -->
                    <div id="searchBadge" class="<%= (!filters || !filters.search) ? 'hidden' : '' %> px-3 py-1.5 bg-blue-50 text-blue-600 text-xs font-medium rounded-full flex items-center">
                        <i class="fas fa-search text-blue-600 mr-2"></i>
                        <span id="searchBadgeText" title="<%= filters && filters.search ? filters.search : '' %>">
                            Search: <%= filters && filters.search ? (filters.search.length > 15 ? filters.search.substring(0, 15) + '...' : filters.search) : '' %>
                        </span>
                        <button class="ml-2 focus:outline-none hover:text-blue-800" id="clearSearchFilter">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                    
                    <!-- Clear all filters button -->
                    <button id="clearAllFilters" class="ml-auto text-sm text-blue-600 hover:text-blue-800 focus:outline-none transition-colors duration-200 flex items-center">
                        <i class="fas fa-times-circle mr-1.5"></i>
                        Clear all
                    </button>
                </div>
            </div>
            
            <div class="p-4 md:p-6">
                <% if (voters.length === 0) { %>
                    <div class="flex flex-col items-center justify-center py-12 text-center">
                        <div class="bg-blue-50 rounded-full p-5 mb-4">
                            <i class="fas fa-folder-open text-blue-500 text-3xl"></i>
                        </div>
                        <h4 class="text-lg font-medium text-gray-700 mb-2">No Applications Yet</h4>
                        <p class="text-gray-500 max-w-md">No voter ID applications have been submitted yet. They will appear here once received.</p>
                    </div>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr class="bg-gray-50">
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Applicant</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date of Birth</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Application Date</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-100">
                                <% voters.forEach(voter => { %>
                                    <tr class="hover:bg-gray-50 transition-colors voter-row" 
                                        data-status="<%= voter.status %>"
                                        data-search="<%= voter.firstName.toLowerCase() %> <%= voter.lastName.toLowerCase() %> <%= voter.id.toLowerCase() %>">
                                        <td class="px-4 py-4 text-sm text-gray-600 whitespace-nowrap"><%= voter.id %></td>
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-10 w-10 bg-gray-100 rounded-full overflow-hidden">
                                                    <% if(voter.photoPath) { %>
                                                        <img src="/<%= voter.photoPath %>" alt="<%= voter.firstName %>" class="h-full w-full object-cover">
                                                    <% } else { %>
                                                        <div class="h-full w-full flex items-center justify-center">
                                                            <i class="fas fa-user text-gray-400"></i>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-sm font-medium text-gray-900"><%= voter.firstName %> <%= voter.lastName %></div>
                                                    <div class="text-sm text-gray-500"><%= voter.idNumber %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 text-sm text-gray-600 whitespace-nowrap"><%= voter.dob %></td>
                                        <td class="px-4 py-4 text-sm text-gray-600 whitespace-nowrap"><%= voter.createdAt.toLocaleDateString() %></td>
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <% if(voter.status === 'approved') { %>
                                                <span class="px-3 py-1.5 inline-flex items-center text-xs leading-4 font-semibold rounded-full bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1.5"></i> Approved
                                                </span>
                                            <% } else if(voter.status === 'rejected') { %>
                                                <span class="px-3 py-1.5 inline-flex items-center text-xs leading-4 font-semibold rounded-full bg-red-100 text-red-800">
                                                    <i class="fas fa-times-circle mr-1.5"></i> Rejected
                                                </span>
                                            <% } else { %>
                                                <span class="px-3 py-1.5 inline-flex items-center text-xs leading-4 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                    <i class="fas fa-clock mr-1.5"></i> Pending
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-sm font-medium">
                                            <div class="flex space-x-2">
                                                <a href="/admin/voter/<%= voter.id %>" 
                                                   class="p-2 bg-blue-50 text-blue-600 rounded-md hover:bg-blue-100 transition inline-flex items-center justify-center w-8 h-8"
                                                   title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <% if(voter.status === 'pending') { %>
                                                    <form action="/admin/approve/<%= voter.id %>" method="POST" class="inline">
                                                        <button type="submit" 
                                                                class="p-2 bg-green-50 text-green-600 rounded-md hover:bg-green-100 transition inline-flex items-center justify-center w-8 h-8"
                                                                title="Approve Application">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/reject/<%= voter.id %>" method="POST" class="inline">
                                                        <button type="submit" 
                                                                class="p-2 bg-red-50 text-red-600 rounded-md hover:bg-red-100 transition inline-flex items-center justify-center w-8 h-8"
                                                                title="Reject Application">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination Controls -->
                    <% if (pagination.totalPages > 1) { %>
                        <div class="mt-6 px-4 flex items-center justify-between border-t border-gray-200 pt-6">
                            <div class="text-sm text-gray-700">
                                Showing <span class="font-medium"><%= (pagination.page - 1) * pagination.limit + 1 %></span> to 
                                <span class="font-medium"><%= Math.min(pagination.page * pagination.limit, filteredCount) %></span> of 
                                <span class="font-medium"><%= filteredCount %></span> applications
                                <% if (filteredCount !== totalVoters) { %>
                                    <span class="text-gray-500">(filtered from <%= totalVoters %> total)</span>
                                <% } %>
                            </div>
                            <div class="flex space-x-1">
                                <!-- Previous Page Button -->
                                <% if (pagination.hasPrev) { %>
                                    <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>" 
                                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                        <i class="fas fa-chevron-left mr-1"></i>
                                        Previous
                                    </a>
                                <% } else { %>
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-200 text-sm font-medium rounded-md text-gray-400 bg-gray-50 cursor-not-allowed">
                                        <i class="fas fa-chevron-left mr-1"></i>
                                        Previous
                                    </span>
                                <% } %>
                                
                                <!-- Page Numbers -->
                                <div class="hidden md:flex">
                                    <% 
                                    // Calculate range of page numbers to show
                                    let startPage = Math.max(1, pagination.page - 2);
                                    let endPage = Math.min(pagination.totalPages, pagination.page + 2);
                                    
                                    // Show first page if not in range
                                    if (startPage > 1) { %>
                                        <a href="?page=1&limit=<%= pagination.limit %>" 
                                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                            1
                                        </a>
                                        <% if (startPage > 2) { %>
                                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white">
                                                ...
                                            </span>
                                        <% } %>
                                    <% } %>
                                    
                                    <% for (let i = startPage; i <= endPage; i++) { %>
                                        <% if (i === pagination.page) { %>
                                            <span class="relative inline-flex items-center px-4 py-2 border border-blue-500 text-sm font-medium rounded-md text-white bg-blue-600">
                                                <%= i %>
                                            </span>
                                        <% } else { %>
                                            <a href="?page=<%= i %>&limit=<%= pagination.limit %>" 
                                               class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                                <%= i %>
                                            </a>
                                        <% } %>
                                    <% } %>
                                    
                                    <!-- Show last page if not in range -->
                                    <% if (endPage < pagination.totalPages) { %>
                                        <% if (endPage < pagination.totalPages - 1) { %>
                                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white">
                                                ...
                                            </span>
                                        <% } %>
                                        <a href="?page=<%= pagination.totalPages %>&limit=<%= pagination.limit %>" 
                                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                            <%= pagination.totalPages %>
                                        </a>
                                    <% } %>
                                </div>
                                
                                <!-- Records Per Page Selector -->
                                <select id="perPageSelector" 
                                        class="relative inline-flex items-center px-2 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:border-blue-400 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-colors duration-200">
                                    <option value="10" <%= pagination.limit === 10 ? 'selected' : '' %>>10 per page</option>
                                    <option value="25" <%= pagination.limit === 25 ? 'selected' : '' %>>25 per page</option>
                                    <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50 per page</option>
                                    <option value="100" <%= pagination.limit === 100 ? 'selected' : '' %>>100 per page</option>
                                </select>
                                
                                <!-- Next Page Button -->
                                <% if (pagination.hasNext) { %>
                                    <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>" 
                                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                        Next
                                        <i class="fas fa-chevron-right ml-1"></i>
                                    </a>
                                <% } else { %>
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-200 text-sm font-medium rounded-md text-gray-400 bg-gray-50 cursor-not-allowed">
                                        Next
                                        <i class="fas fa-chevron-right ml-1"></i>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
                
                <!-- No Results Message (hidden by default) -->
                <div id="noResultsMessage" class="flex flex-col items-center justify-center py-8 text-center hidden">
                    <div class="bg-blue-50 rounded-full p-3 mb-3">
                        <i class="fas fa-search text-blue-500 text-xl"></i>
                    </div>
                    <h4 class="text-lg font-medium text-gray-700 mb-2">No Matching Results</h4>
                    <p class="text-gray-500 max-w-md">No applications match your current search criteria. Try adjusting your filters.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Note: Switched from modal popup to direct links to individual voter pages -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // Enhanced filtering system
        const $statusFilter = $('#statusFilter');
        const $searchBox = $('#searchBox');
        const $voterRows = $('.voter-row');
        const $noResultsMessage = $('#noResultsMessage');
        const $clearSearch = $('#clearSearch');
        const $activeFilters = $('#activeFilters');
        const $statusBadge = $('#statusBadge');
        const $statusBadgeText = $('#statusBadgeText');
        const $searchBadge = $('#searchBadge');
        const $searchBadgeText = $('#searchBadgeText');
        const $perPageSelector = $('#perPageSelector');
        
        // Handle records per page selector change
        $perPageSelector.on('change', function() {
            const newLimit = $(this).val();
            const currentUrl = new URL(window.location.href);
            
            // Update limit parameter
            currentUrl.searchParams.set('limit', newLimit);
            // Reset to page 1 when changing items per page
            currentUrl.searchParams.set('page', '1');
            
            // Preserve filters if they exist
            const statusValue = $statusFilter.val();
            if (statusValue && statusValue !== 'all') {
                currentUrl.searchParams.set('status', statusValue);
            }
            
            const searchValue = $searchBox.val();
            if (searchValue) {
                currentUrl.searchParams.set('search', searchValue);
            }
            
            // Navigate to new URL
            window.location.href = currentUrl.toString();
        });
        
        // Update pagination links to preserve filters
        function updatePaginationLinks() {
            // Get current filter values
            const statusValue = $statusFilter.val();
            const searchValue = $searchBox.val();
            
            // Only proceed if we have active filters
            if ((statusValue && statusValue !== 'all') || searchValue) {
                // Update all pagination links
                $('a[href*="?page="]').each(function() {
                    const link = $(this);
                    const url = new URL(link.attr('href'), window.location.origin + window.location.pathname);
                    
                    // Add status filter if present
                    if (statusValue && statusValue !== 'all') {
                        url.searchParams.set('status', statusValue);
                    }
                    
                    // Add search filter if present
                    if (searchValue) {
                        url.searchParams.set('search', searchValue);
                    }
                    
                    // Update href attribute
                    link.attr('href', url.search);
                });
            }
        }
        
        // Initial state check
        updateFilterVisibility();
        
        // Check URL parameters for filters on page load
        function applyUrlFilters() {
            const urlParams = new URLSearchParams(window.location.search);
            const statusParam = urlParams.get('status');
            const searchParam = urlParams.get('search');
            
            // Apply status filter if in URL
            if (statusParam) {
                $statusFilter.val(statusParam);
            }
            
            // Apply search filter if in URL
            if (searchParam) {
                $searchBox.val(searchParam);
                $clearSearch.removeClass('hidden');
            }
            
            // Apply filters if any parameters were found
            if (statusParam || searchParam) {
                filterVoters();
                updatePaginationLinks();
            }
        }
        
        function filterVoters() {
            const statusValue = $statusFilter.val() || 'all';
            const searchValue = $searchBox.val().toLowerCase();
            
            let visibleCount = 0;
            
            $voterRows.each(function() {
                const $row = $(this);
                const rowStatus = $row.data('status');
                const rowSearchText = $row.data('search');
                
                // Check if status matches (or 'all' is selected)
                const statusMatch = statusValue === 'all' || rowStatus === statusValue;
                
                // Check if search text matches the combined data
                const searchMatch = searchValue === '' || rowSearchText.includes(searchValue);
                
                // Show/hide the row based on combined filters
                if (statusMatch && searchMatch) {
                    $row.show();
                    visibleCount++;
                } else {
                    $row.hide();
                }
            });
            
            // Show/hide no results message
            if (visibleCount === 0 && $voterRows.length > 0) {
                $noResultsMessage.removeClass('hidden');
            } else {
                $noResultsMessage.addClass('hidden');
            }
            
            // Update filter badges
            updateFilterVisibility();
            
            // Update pagination links to preserve filters
            updatePaginationLinks();
        }
        
        function updateFilterVisibility() {
            const statusValue = $statusFilter.val() || 'all';
            const searchValue = $searchBox.val().toLowerCase();
            
            // Update clear search button visibility
            if (searchValue.length > 0) {
                $clearSearch.removeClass('hidden');
            } else {
                $clearSearch.addClass('hidden');
            }
            
            // Update status badge
            if (statusValue !== 'all') {
                $statusBadge.removeClass('hidden');
                $statusBadgeText.text('Status: ' + statusValue.charAt(0).toUpperCase() + statusValue.slice(1));
            } else {
                $statusBadge.addClass('hidden');
            }
            
            // Update search badge
            if (searchValue.length > 0) {
                $searchBadge.removeClass('hidden');
                // Truncate long search values to keep badge concise
                const truncatedValue = searchValue.length > 15 ? searchValue.substring(0, 15) + '...' : searchValue;
                $searchBadgeText.text('Search: ' + truncatedValue);
                // Add title attribute for full value on hover
                $searchBadgeText.attr('title', searchValue);
            } else {
                $searchBadge.addClass('hidden');
            }
            
            // Show/hide active filters section
            if (statusValue !== 'all' || searchValue.length > 0) {
                $activeFilters.removeClass('hidden');
            } else {
                $activeFilters.addClass('hidden');
            }
        }
        
        // Clear search field
        function clearSearch() {
            $searchBox.val('');
            $clearSearch.addClass('hidden');
            filterVoters();
        }
        
        // Reset status filter
        function clearStatusFilter() {
            $statusFilter.val('all');
            filterVoters();
        }
        
        // Clear all filters
        function clearAllFilters() {
            clearSearch();
            clearStatusFilter();
        }
        
        // Add event listeners
        $statusFilter.on('change', filterVoters);
        $searchBox.on('input', filterVoters);
        $clearSearch.on('click', clearSearch);
        $('#clearStatusFilter').on('click', clearStatusFilter);
        $('#clearSearchFilter').on('click', clearSearch);
        $('#clearAllFilters').on('click', clearAllFilters);
        
        // Clear search on escape key
        $searchBox.on('keyup', function(e) {
            if (e.key === 'Escape') {
                clearSearch();
            }
        });
        
        // Additional event listeners for server-side filtering
        $statusFilter.on('change', function() {
            const currentUrl = new URL(window.location.href);
            const statusValue = $(this).val();
            
            // Update or clear status parameter based on selection
            if (statusValue === 'all') {
                currentUrl.searchParams.delete('status');
            } else {
                currentUrl.searchParams.set('status', statusValue);
            }
            
            // Reset to page 1 when applying filters
            currentUrl.searchParams.set('page', '1');
            
            // Preserve search filter if it exists
            const searchValue = $searchBox.val();
            if (searchValue) {
                currentUrl.searchParams.set('search', searchValue);
            }
            
            // Navigate to new URL
            window.location.href = currentUrl.toString();
        });
        
        // Use debounce for search input to reduce server requests
        let searchTimeout;
        $searchBox.on('input', function() {
            clearTimeout(searchTimeout);
            
            // Wait 500ms after typing stops before submitting search
            searchTimeout = setTimeout(function() {
                const currentUrl = new URL(window.location.href);
                const searchValue = $searchBox.val();
                
                // Update or clear search parameter based on input
                if (!searchValue) {
                    currentUrl.searchParams.delete('search');
                } else {
                    currentUrl.searchParams.set('search', searchValue);
                }
                
                // Reset to page 1 when applying filters
                currentUrl.searchParams.set('page', '1');
                
                // Preserve status filter if it exists
                const statusValue = $statusFilter.val();
                if (statusValue && statusValue !== 'all') {
                    currentUrl.searchParams.set('status', statusValue);
                }
                
                // Navigate to new URL
                window.location.href = currentUrl.toString();
            }, 500);
        });
        
        // Apply URL filters on page load
        applyUrlFilters();
    });
</script>

