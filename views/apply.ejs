<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Voter ID Application Form</h3>
    </div>
    <div class="card-body">
        <% if (typeof error !== 'undefined') { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            </div>
        <% } %>
        
        <form action="/apply" method="POST" enctype="multipart/form-data" class="needs-validation">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="firstName" class="form-label">First Name<span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="firstName" name="firstName" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="lastName" class="form-label">Last Name<span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="lastName" name="lastName" required>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="dob" class="form-label">Date of Birth<span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="dob" name="dob" required>
                    <% if (parseInt(process.env.MIN_VOTER_AGE) > 0) { %>
                    <small class="text-muted">You must be at least <%= process.env.MIN_VOTER_AGE %> years old to apply</small>
                    <% } %>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="idNumber" class="form-label">RID (Registration ID)<span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="idNumber" name="idNumber" required>
                    <small class="text-muted">Enter your Registration ID (RID) number</small>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="address" class="form-label">Residential Address<span class="text-danger">*</span></label>
                <textarea class="form-control" id="address" name="address" rows="3" required></textarea>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="phone" class="form-label">Phone Number<span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="phone" name="phone" required>
                    <small class="text-muted">Your phone number will be used for verification and updates</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email">
                    <small class="text-muted">Optional, but recommended for digital ID delivery</small>
                </div>
            </div>
            
            <div class="mb-4">
                <label for="photo" class="form-label">Photo<span class="text-danger">*</span></label>
                <input type="file" class="form-control" id="photo" name="photo" accept="image/*" required>
                <small class="text-muted">Upload a recent passport-style photo. Only JPG, PNG formats allowed.</small>
                <div class="mt-2">
                    <img id="photoPreview" src="#" alt="Photo Preview" class="img-thumbnail" style="max-height: 150px; display: none;">
                </div>
            </div>
            
            <div class="mb-3 border p-3 bg-light">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="agree" required>
                    <label class="form-check-label" for="agree">
                        I hereby declare that the information provided above is true and correct to the best of my knowledge and belief.
                    </label>
                </div>
            </div>
            
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane me-2"></i>Submit Application
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">Application Process Information</h5>
    </div>
    <div class="card-body">
        <div class="d-flex mb-3">
            <div class="me-4 text-primary text-center" style="width: 50px;">
                <i class="fas fa-file-alt fa-2x"></i>
                <div class="small mt-1">Step 1</div>
            </div>
            <div>
                <h6>Submit Application</h6>
                <p class="text-muted">Complete the application form with all required information and upload your photo.</p>
            </div>
        </div>
        
        <div class="d-flex mb-3">
            <div class="me-4 text-primary text-center" style="width: 50px;">
                <i class="fas fa-clock fa-2x"></i>
                <div class="small mt-1">Step 2</div>
            </div>
            <div>
                <h6>Verification Period</h6>
                <p class="text-muted">Your application will be reviewed by the Electoral Commission. This typically takes 3-5 business days.</p>
            </div>
        </div>
        
        <div class="d-flex">
            <div class="me-4 text-primary text-center" style="width: 50px;">
                <i class="fas fa-id-card fa-2x"></i>
                <div class="small mt-1">Step 3</div>
            </div>
            <div>
                <h6>Receive Your ID</h6>
                <p class="text-muted">Once approved, you will receive a digital voter ID card. You can print or keep the digital version.</p>
            </div>
        </div>
    </div>
</div> 