<div class="mb-10">
    <div class="border-b border-gray-200 pb-5 mb-6">
        <h1 class="text-2xl font-bold leading-7 text-gray-900">Voter ID Application Form</h1>
        <p class="mt-1 text-sm leading-6 text-gray-500">Please complete all required fields marked with an asterisk (*)</p>
    </div>
    
    <% if (typeof error !== 'undefined') { %>
        <div class="rounded-md bg-danger-50 p-4 mb-6">
            <div class="flex">
                <i class="fas fa-exclamation-circle flex-shrink-0 h-5 w-5 text-danger-400 mt-0.5"></i>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-danger-800"><%= error %></h3>
                </div>
            </div>
        </div>
    <% } %>
    
    <div class="bg-white shadow-sm rounded-lg overflow-hidden">
        <form action="/apply" method="POST" enctype="multipart/form-data" class="p-6">
            <!-- Personal Information Section -->
            <div class="mb-8">
                <h2 class="text-base font-semibold leading-7 text-gray-900 mb-6">Personal Information</h2>
                
                <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <!-- First Name & Last Name -->
                    <div class="sm:col-span-3">
                        <label for="firstName" class="form-label">
                            First Name<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="text" id="firstName" name="firstName" 
                            class="form-input" required>
                    </div>
                    
                    <div class="sm:col-span-3">
                        <label for="lastName" class="form-label">
                            Last Name<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="text" id="lastName" name="lastName" 
                            class="form-input" required>
                    </div>
                    
                    <!-- Date of Birth & Gender -->
                    <div class="sm:col-span-3">
                        <label for="dob" class="form-label">
                            Date of Birth<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="date" id="dob" name="dob" 
                            class="form-input" required>
                        <% if (parseInt(process.env.MIN_VOTER_AGE) > 0) { %>
                            <p class="mt-1 text-sm text-gray-500">
                                You must be at least <%= process.env.MIN_VOTER_AGE %> years old to apply
                            </p>
                        <% } %>
                    </div>
                    
                    <div class="sm:col-span-3">
                        <label for="gender" class="form-label">
                            Gender<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <select id="gender" name="gender" class="form-input" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                            <option value="Prefer not to say">Prefer not to say</option>
                        </select>
                    </div>
                    
                    <!-- Address Details -->
                    <div class="sm:col-span-6">
                        <label for="addressLine1" class="form-label">
                            Address Line 1<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="text" id="addressLine1" name="addressLine1" 
                            class="form-input" required>
                    </div>
                    
                    <div class="sm:col-span-6">
                        <label for="addressLine2" class="form-label">
                            Address Line 2
                        </label>
                        <input type="text" id="addressLine2" name="addressLine2" 
                            class="form-input">
                    </div>
                    
                    <div class="sm:col-span-3">
                        <label for="city" class="form-label">
                            City<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="text" id="city" name="city" 
                            class="form-input" required>
                    </div>
                    
                    <div class="sm:col-span-3">
                        <label for="postalCode" class="form-label">
                            Postal Code<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="text" id="postalCode" name="postalCode" 
                            class="form-input" required>
                    </div>
                </div>
            </div>
            
            <!-- Contact Information Section -->
            <div class="mb-8 pt-6 border-t border-gray-100">
                <h2 class="text-base font-semibold leading-7 text-gray-900 mb-6">Contact Information</h2>
                
                <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <!-- Phone & Email -->
                    <div class="sm:col-span-3">
                        <label for="phone" class="form-label">
                            Phone Number<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <input type="tel" id="phone" name="phone" 
                            class="form-input" required>
                        <p class="mt-1 text-sm text-gray-500">
                            Your phone number will be used for verification and updates
                        </p>
                    </div>
                    
                    <div class="sm:col-span-3">
                        <label for="email" class="form-label">
                            Email Address
                        </label>
                        <input type="email" id="email" name="email" 
                            class="form-input">
                        <p class="mt-1 text-sm text-gray-500">
                            Optional, but recommended for digital ID delivery
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Photo Upload Section -->
            <div class="mb-8 pt-6 border-t border-gray-100">
                <h2 class="text-base font-semibold leading-7 text-gray-900 mb-6">Photo Upload</h2>
                
                <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                    <div class="sm:col-span-6">
                        <label for="photo" class="form-label">
                            Photo<span class="text-danger-500 ml-1">*</span>
                        </label>
                        <div class="mt-2 flex justify-center rounded-lg border border-dashed border-gray-900/25 px-6 py-10" id="dropArea">
                            <div class="text-center">
                                <i class="fas fa-camera text-gray-400 text-3xl mb-2"></i>
                                <div class="mt-1 text-sm leading-6 text-gray-600">
                                    <label for="photo" class="cursor-pointer relative rounded-md bg-white font-semibold text-primary-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-primary-600 focus-within:ring-offset-2 hover:text-primary-500">
                                        <span>Upload a photo</span>
                                        <input id="photo" name="photo" type="file" accept="image/*" required class="sr-only">
                                    </label>
                                    <p class="pl-1 text-gray-500">or drag and drop</p>
                                </div>
                                <p class="text-xs leading-5 text-gray-600">JPG, PNG up to 10MB</p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <img id="photoPreview" src="#" alt="Photo Preview" class="hidden max-h-48 rounded-md object-cover">
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Terms and Submit -->
            <div class="mb-8 pt-6 border-t border-gray-100">
                <div class="rounded-md border border-gray-200 bg-gray-50 p-4 mb-6">
                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input id="agree" name="agree" type="checkbox" required 
                                class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-600">
                        </div>
                        <div class="ml-3 text-sm">
                            <label for="agree" class="font-medium text-gray-700">
                                Declaration
                            </label>
                            <p class="text-gray-500">
                                I hereby declare that the information provided above is true and correct to the best of my knowledge and belief.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center justify-end gap-x-6">
                    <button type="reset" class="btn btn-secondary">
                        Reset Form
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane mr-2"></i>Submit Application
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Application Process Card -->
<div class="bg-white shadow-sm rounded-lg overflow-hidden mb-10">
    <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium leading-6 text-gray-900">
            Application Process Information
        </h3>
    </div>
    <div class="p-6">
        <ol class="relative border-l border-gray-200 ml-3">
            <li class="mb-10 ml-6">
                <span class="absolute flex items-center justify-center w-10 h-10 bg-primary-100 rounded-full -left-5 ring-4 ring-white">
                    <i class="fas fa-file-alt text-primary-600"></i>
                </span>
                <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900">
                    Submit Application
                </h3>
                <p class="mb-4 text-base font-normal text-gray-600">
                    Complete the application form with all required information and upload your photo.
                </p>
            </li>
            <li class="mb-10 ml-6">
                <span class="absolute flex items-center justify-center w-10 h-10 bg-primary-100 rounded-full -left-5 ring-4 ring-white">
                    <i class="fas fa-clock text-primary-600"></i>
                </span>
                <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900">
                    Verification Period
                </h3>
                <p class="mb-4 text-base font-normal text-gray-600">
                    Your application will be reviewed by the Electoral Commission. This typically takes 3-5 business days.
                </p>
            </li>
            <li class="ml-6">
                <span class="absolute flex items-center justify-center w-10 h-10 bg-primary-100 rounded-full -left-5 ring-4 ring-white">
                    <i class="fas fa-id-card text-primary-600"></i>
                </span>
                <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900">
                    Receive Your ID
                </h3>
                <p class="mb-4 text-base font-normal text-gray-600">
                    Once approved, you will receive a digital voter ID card. You can print or keep the digital version.
                </p>
            </li>
        </ol>
    </div>
</div>

<script>
    // Photo preview functionality
    const photoInput = document.getElementById('photo');
    const photoPreview = document.getElementById('photoPreview');
    const dropArea = document.getElementById('dropArea');
    
    photoInput.addEventListener('change', function() {
        showPreview(this.files[0]);
    });
    
    // Drag and drop functionality
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
    });
    
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, highlight, false);
    });
    
    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, unhighlight, false);
    });
    
    function highlight() {
        dropArea.classList.add('bg-primary-50', 'border-primary-300');
    }
    
    function unhighlight() {
        dropArea.classList.remove('bg-primary-50', 'border-primary-300');
    }
    
    dropArea.addEventListener('drop', handleDrop, false);
    
    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        
        if (files.length) {
            photoInput.files = files;
            showPreview(files[0]);
        }
    }
    
    function showPreview(file) {
        if (!file || !file.type.startsWith('image/')) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
            photoPreview.src = e.target.result;
            photoPreview.classList.remove('hidden');
            photoPreview.classList.add('block');
        }
        reader.readAsDataURL(file);
    }
</script> 